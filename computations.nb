Cell[TextData[{
 "For  ",
 Cell[BoxData[
  RowBox[{"0", "<", "l", "<", "1"}]], "InlineCode",ExpressionUUID->
  "359f4a57-fd62-418a-a503-2f657fd405b2"],
 ", the function ",
 Cell[BoxData[
  RowBox[{"P", 
   RowBox[{"(", 
    RowBox[{"u", ",", "l"}], ")"}]}]], "InlineCode",ExpressionUUID->
  "68eef966-ae6d-4578-a7e6-6a10727ee5a1"],
 "is strictly convex on ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], ")"}]], "InlineCode",ExpressionUUID->
  "fd90d9e5-36f2-4463-b7dd-46627726267e"],
 ". Hence, its critical point is its global minimum. We then maximize ",
 Cell[BoxData[
  RowBox[{"P", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["u", "0"], ",", "l"}], ")"}]}]], "InlineCode",
  ExpressionUUID->"abdc77e2-3ebc-4084-b91b-c5403f044833"],
 " with respect to ",
 Cell[BoxData[
 "l"], "InlineCode",ExpressionUUID->"1da747bc-69c0-42c3-b176-5324602899b2"],
 ". \nWe compute its first derivative in ",
 Cell[BoxData[
 "l"], "InlineCode",ExpressionUUID->"503d37fa-e1e0-4e4d-85de-4b240560f800"],
 " and compute the critical value ",
 Cell[BoxData[
  SubscriptBox["l", "0"]], "InlineCode",ExpressionUUID->
  "c5c72f83-45b9-4501-9af8-c98c607f5f63"],
 "."
}], "Text",
