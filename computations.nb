Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MaximizingF", "[", 
    RowBox[{
     RowBox[{"l1_", "?", "NumericQ"}], ",", 
     RowBox[{"l2_", "?", "NumericQ"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"If", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"l1", ">=", "eps"}], "&&", 
      RowBox[{"l2", ">=", "eps"}], "&&", 
      RowBox[{
       RowBox[{"l1", "+", "l2"}], "<=", 
       RowBox[{"1", "-", "eps"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"Q1", "[", 
        RowBox[{"l1", ",", "l2"}], "]"}], ",", 
       RowBox[{"Q2", "[", 
        RowBox[{"l1", ",", "l2"}], "]"}]}], "]"}], ",", 
     RowBox[{"-", "1"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000725082288664*^9, 4.000725084662735*^9}, {
  4.000725243029811*^9, 4.000725264501053*^9}, {4.0007257421495733`*^9, 
