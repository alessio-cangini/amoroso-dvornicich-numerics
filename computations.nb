 RowBox[{"Clear", "[", 
  RowBox[{
  "A3", ",", "Q", ",", "dQdu", ",", "u1", ",", "Q1", ",", "Q2", ",", "eps", ",",
    "MaximizingF", ",", "heightBound2", ",", "u11", ",", "u12"}], 
  "]"}]], "Input",
