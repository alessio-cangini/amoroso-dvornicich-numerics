Cell[BoxData[{
 RowBox[{
  RowBox[{"A1", "[", "u_", "]"}], ":=", 
  RowBox[{"Log", "[", 
   FractionBox["8", 
    RowBox[{"1", "-", "u"}]], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A2", "[", "u_", "]"}], ":=", 
  RowBox[{"Log", "[", 
   FractionBox["2", 
    RowBox[{"1", "+", "u"}]], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "[", 
   RowBox[{"u_", ",", "l_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"l", " ", 
    RowBox[{"A1", "[", "u", "]"}]}], "+", 
