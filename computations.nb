 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["F", "1"], 
    RowBox[{"(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], "=", 
   RowBox[{"X", "-", "Y"}]}]], "InlineCode",ExpressionUUID->
  "7648b940-7904-4616-a8a3-97ee8bddecde"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["F", "2"], 
    RowBox[{"(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], "=", 
   RowBox[{"X", "+", "Y"}]}]], "InlineCode",ExpressionUUID->
  "37fdfe6d-5085-448f-a2e4-d623f8dd987b"],
 " and the convex combination ",
 Cell[BoxData[
 "P"], "InlineCode",ExpressionUUID->"0f8a723c-9988-46bb-bd21-b6381f2b03f8"],
 ". The weight ",
 Cell[BoxData[
 "l"], "InlineCode",ExpressionUUID->"6e27f0f6-2eb2-4556-beff-4a1220e23bb6"],
