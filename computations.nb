Cell[BoxData[
 RowBox[{
  RowBox[{"A4", "[", "u_", "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"Log", "[", 
    FractionBox["64", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"29", 
        SuperscriptBox["u", "2"]}], "+", 
       RowBox[{"30", "u"}], "+", "5"}], "]"}]], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0007815454484262`*^9, 4.000781571773884*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"860f7560-c038-4bd8-94ef-cf3adc9eb724"],

Cell[TextData[{
 "Consider the convex combination ",
 Cell[BoxData[
 "R"], "InlineCode",ExpressionUUID->"85bcaee3-31ae-49d7-9468-5044b776ecc0"],
 " of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["A", "1"], ",", "...", ",", 
   SubscriptBox["A", "4"]}]], "InlineCode",ExpressionUUID->
  "7b283dd1-b6e2-48c4-8f00-5ecb5cfda396"]
}], "Text",
 CellChangeTimes->{{4.0007816602074423`*^9, 
  4.0007816850367517`*^9}},ExpressionUUID->"cc914bc9-b312-4548-b5cd-\
3637d90fd622"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"R", "[", 
    RowBox[{"u_", ",", "l1_", ",", "l2_", ",", "l3_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"l1", " ", 
     RowBox[{"A1", "[", "u", "]"}]}], "+", 
    RowBox[{"l2", " ", 
     RowBox[{"A2", "[", "u", "]"}]}], "+", 
    RowBox[{"l3", " ", 
     RowBox[{"A3", "[", "u", "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "l1", "-", "l2", "-", "l3"}], ")"}], 
     RowBox[{"A4", "[", "u", "]"}]}]}]}], ";", 
  RowBox[{"R", "[", 
   RowBox[{"u", ",", "l1", ",", "l2", ",", "l3"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0007864751708527`*^9, 4.000786481595656*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"788f24b6-38d7-48fb-a443-f08e35fbd825"],

Cell[BoxData[
 RowBox[{
  RowBox[{"l1", " ", 
   RowBox[{"Log", "[", 
    FractionBox["8", 
     RowBox[{"1", "-", "u"}]], "]"}]}], "+", 
  RowBox[{"l2", " ", 
   RowBox[{"Log", "[", 
    FractionBox["2", 
     RowBox[{"1", "+", "u"}]], "]"}]}], "+", 
  RowBox[{"l3", " ", 
   RowBox[{"Log", "[", 
    FractionBox["8", 
     RowBox[{"Abs", "[", 
      RowBox[{"3", "+", 
       RowBox[{"5", " ", "u"}]}], "]"}]], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", "l1", "-", "l2", "-", "l3"}], ")"}], " ", 
   RowBox[{"Log", "[", 
    FractionBox["64", 
     RowBox[{"Abs", "[", 
      RowBox[{"5", "+", 
       RowBox[{"30", " ", "u"}], "+", 
       RowBox[{"29", " ", 
        SuperscriptBox["u", "2"]}]}], "]"}]], "]"}]}]}]], "Output",
 CellChangeTimes->{{4.000786475339106*^9, 4.000786482150691*^9}, 
   4.000812632197921*^9, 4.000818631228381*^9, 4.0008196327976847`*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"84f72058-4996-4035-970f-62a92b9ef97e"]
}, Open  ]],

