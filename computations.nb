Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"R", "[", 
      RowBox[{"u", ",", "l1", ",", "l2", ",", "l3"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "2"}], "}"}]}], "]"}], "//", "ComplexExpand"}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{4.000781827579674*^9, 4.000781836194549*^9}, {
  4.000782951058549*^9, 4.000782982961885*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"a5979b7d-72ea-4f13-9495-eb89d14461a6"],

Cell[BoxData[
 RowBox[{
  FractionBox["l1", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "u"}], ")"}], "2"]], "+", 
  FractionBox["l2", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "u"}], ")"}], "2"]], "+", 
  FractionBox[
   RowBox[{"25", " ", "l3"}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"3", "+", 
      RowBox[{"5", " ", "u"}]}], ")"}], "2"]], "-", 
  FractionBox[
   RowBox[{"160", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "l1", "+", "l2", "+", "l3"}], ")"}]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"5", "+", 
      RowBox[{"u", " ", 
       RowBox[{"(", 
        RowBox[{"30", "+", 
         RowBox[{"29", " ", "u"}]}], ")"}]}]}], ")"}], "2"]], "-", 
  FractionBox[
   RowBox[{"29", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "l1", "+", "l2", "+", "l3"}], ")"}]}], 
   RowBox[{"5", "+", 
    RowBox[{"u", " ", 
     RowBox[{"(", 
      RowBox[{"30", "+", 
       RowBox[{"29", " ", "u"}]}], ")"}]}]}]]}]], "Output",
 CellChangeTimes->{{4.00078183003897*^9, 4.000781836636047*^9}, 
   4.000782188475091*^9, 4.0007822214485607`*^9, {4.00078296035959*^9, 
   4.000782988336368*^9}, 4.0007862288426332`*^9, 4.000812633154286*^9, 
   4.000818632182415*^9, 4.0008196337295437`*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"642bad19-3d5c-4050-86ea-6a490b2a604f"]
