Cell[TextData[{
 "Consider the functions ",
 Cell[BoxData[
  SubscriptBox["A", "1"]], "InlineCode",ExpressionUUID->
  "e60f0e9c-5dbf-441d-a4dd-31e4d0114fb3"],
