Cell[CellGroupData[{

Cell["Case with three polynomials", "Section",
 CellChangeTimes->{{4.00072429791838*^9, 4.000724307350699*^9}, {
  4.0007245976856194`*^9, 4.0007245981356573`*^9}, {4.000776388251657*^9, 
  4.0007763959162283`*^9}},ExpressionUUID->"7b38d921-689a-477f-99a8-\
54601d75e430"],

Cell[TextData[{
 "Consider the function ",
 Cell[BoxData[
  SubscriptBox["A", "3"]], "InlineCode",ExpressionUUID->
  "3c734f2f-f3b3-4e82-b5ff-1f87c2f1f361"],
 " associated with the polynomial ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["F", "3"], 
    RowBox[{"(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], "=", 
   RowBox[{
    RowBox[{"5", 
     SuperscriptBox["X", "2"]}], "+", 
    RowBox[{"6", "XY"}], "+", 
    RowBox[{"5", 
     SuperscriptBox["Y", "2"]}]}]}]], "InlineCode",ExpressionUUID->
  "dbd92d2a-d540-4e89-80a6-44954da5e534"],
 " and the convex combination ",
 Cell[BoxData[
 "Q"], "InlineCode",ExpressionUUID->"ebeeb504-b1f1-4ad2-97ad-f0cf12412668"],
 " of ",
 Cell[BoxData[
  SubscriptBox["A", "1"]], "InlineCode",ExpressionUUID->
  "44d01ee0-5067-4f75-9b8f-7cfaed9dbdf0"],
 ", ",
 Cell[BoxData[
  SubscriptBox["A", "2"]], "InlineCode",ExpressionUUID->
  "fcc4741f-b520-4773-a96e-0cf670ce3a63"],
 ", and ",
 Cell[BoxData[
  SubscriptBox["A", "3"]], "InlineCode",ExpressionUUID->
  "741e2e33-e91b-46fd-9e1b-b4c65ef3a90d"],
 ". The weights ",
 Cell[BoxData[
  SubscriptBox["l", "1"]], "InlineCode",ExpressionUUID->
  "47fbcac6-9246-4eaf-a27d-7f6032267f23"],
 " and ",
 Cell[BoxData[
  SubscriptBox["l", "2"]], "InlineCode",ExpressionUUID->
  "79ae56ee-8e58-4e0e-b8cc-b0283d7dd55c"],
 " are nonnegative and such that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["l", "1"], "+", 
    SubscriptBox["l", "2"]}], "\[LessEqual]", "1"}]], "InlineCode",
  ExpressionUUID->"37938dd2-be31-43fe-b9a7-0eba490e959e"],
 "."
}], "Text",
 CellChangeTimes->{{4.000776489953187*^9, 4.0007765362316923`*^9}, {
  4.000776623612021*^9, 
  4.000776691262033*^9}},ExpressionUUID->"e0b192f1-3b41-412b-a5aa-\
2c14317abd6a"],

