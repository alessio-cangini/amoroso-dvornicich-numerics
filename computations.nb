Cell[TextData[{
 "Consider the polynomial ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"B", "[", 
    RowBox[{"u", ",", "a", ",", "b"}], "]"}], "=", 
   RowBox[{
    RowBox[{"a", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"u", "-", "1"}], ")"}], "2"]}], "+", 
    RowBox[{"8", "b", 
     RowBox[{"(", 
      RowBox[{"u", "-", "1"}], ")"}]}], "+", "64"}]}]], "InlineCode",
  ExpressionUUID->"2c933100-133d-4b1a-8972-77c5dd8e349a"],
 ". We compute the real values ",
 Cell[BoxData[
 "aa"], "InlineCode",ExpressionUUID->"263a32e5-f0ea-4b4d-a8a9-191bb6702108"],
 " and ",
 Cell[BoxData[
 "bb"], "InlineCode",ExpressionUUID->"e54956e6-f4fa-471f-85ad-ee9e918cee2d"],
 " for which ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"B", "[", 
    RowBox[{
     SubscriptBox["u", 
      RowBox[{"1", ",", "1"}]], ",", "aa", ",", "bb"}], "]"}], "=", 
   RowBox[{
    RowBox[{"B", "[", 
     RowBox[{
      SubscriptBox["u", 
       RowBox[{"1", ",", "2"}]], ",", "aa", ",", "bb"}], "]"}], "=", "0"}]}]],
   "InlineCode",ExpressionUUID->"8fed72b3-08db-48f8-890c-0822d034ea0d"],
 "."
}], "Text",
