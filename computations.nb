Cell[TextData[{
 "Let ",
 Cell[BoxData[
 "aRounded"], "InlineCode",ExpressionUUID->
  "60dda6de-66fa-42b7-8c7e-348954973a4c"],
 " and ",
 Cell[BoxData[
  FormBox["bRounded", TraditionalForm]],ExpressionUUID->
  "152ee412-104f-4cf1-8674-6dd662e70c6e"],
 " be the nearest integers to ",
 Cell[BoxData[
 "aReal"], "InlineCode",ExpressionUUID->
  "71608b4f-c20e-4367-b16e-161a18716b79"],
 " and ",
 Cell[BoxData[
 "bReal"], "InlineCode",ExpressionUUID->
  "e367f305-a8e1-46b3-94ea-32d703bea23b"],
 ", respectively. We look for integers ",
 Cell[BoxData[
 "a"], "InlineCode",ExpressionUUID->"fe6ff020-3d56-4afe-b31a-6fb75aa2521a"],
 " and ",
 Cell[BoxData[
 "b"], "InlineCode",ExpressionUUID->"82283395-6005-42a0-b3fe-e08c94a042de"],
 " such that ",
 Cell[BoxData[
  RowBox[{"|", 
   RowBox[{"B", "[", 
    RowBox[{"uLeft", ",", "a", ",", "b"}], "]"}], "|", 
   RowBox[{"\[LessEqual]", "R"}]}]], "InlineCode",ExpressionUUID->
  "1641407c-2a3b-47be-9086-7a8373dd0bc9"],
 " and ",
 Cell[BoxData[
  RowBox[{"|", 
   RowBox[{"B", "[", 
    RowBox[{"uRight", ",", "a", ",", "b"}], "]"}], "|", 
   RowBox[{"\[LessEqual]", "R"}]}]], "InlineCode",ExpressionUUID->
  "3db58c96-388e-491a-8d97-1e32797b1810"],
 ", where ",
 Cell[BoxData[
  RowBox[{"R", "=", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"|", 
      RowBox[{"B", "[", 
       RowBox[{"uLeft", ",", "aRounded", ",", "bRounded"}], "]"}], "|"}], ",", 
     RowBox[{"|", 
      RowBox[{"B", "[", 
       RowBox[{"uRight", ",", "aRounded", ",", "bRounded"}], "]"}], "|"}]}], 
    "]"}]}]], "InlineCode",ExpressionUUID->
  "b5e9c45d-8d6c-425c-a91a-fd99dc972d10"],
 "."
}], "Text",
