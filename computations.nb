Cell[TextData[{
 "To compute the critical points of ",
 Cell[BoxData[
 "R"], "InlineCode",ExpressionUUID->"c9fc9e7c-ee3b-4ab8-bfd7-189edc661422"],
 ", we compute the zeros of its numerator. Then, to conclude the height bound \
we maximize in ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["l", "1"], ",", 
   SubscriptBox["l", "2"], ",", 
   SubscriptBox["l", "3"]}]], "InlineCode",ExpressionUUID->
  "1232035c-601d-4792-a475-bba75f4b14c4"],
 "."
}], "Text",
 CellChangeTimes->{{4.000784346945166*^9, 4.000784379977263*^9}, {
  4.0008191378362837`*^9, 
  4.000819188824033*^9}},ExpressionUUID->"29356b91-6512-46c3-8dd8-\
b63e1db07069"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"poly", "=", 
   RowBox[{"Numerator", "[", 
    RowBox[{"Together", "[", "D1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaximizingF1", "[", 
   RowBox[{
    RowBox[{"ll1_", "?", "NumericQ"}], ",", 
    RowBox[{"ll2_", "?", "NumericQ"}], ",", 
    RowBox[{"ll3_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"(*", 
   RowBox[{"?", 
    RowBox[{
    "Numeric_Q", " ", "ensures", " ", "that", " ", "the", " ", "arguments", " ",
      "are", " ", "numeric", " ", "quantities"}]}], "*)"}], 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "roots", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"roots", "=", 
      RowBox[{"NSolveValues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"poly", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"l1", "->", "ll1"}], ",", 
             RowBox[{"l2", "->", "ll2"}], ",", 
             RowBox[{"l3", "->", "ll3"}]}], "}"}]}], ")"}], "==", "0"}], ",", 
        
        RowBox[{"u", "\[Element]", "Reals"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "Numerical", " ", "search", " ", "of", " ", "the", " ", "real", " ", 
       "roots", " ", "of", " ", "the", " ", "first", " ", "derivative"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "roots", "]"}], "!=", "4"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"-", "1"}], "]"}]}], "]"}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Guarantees", " ", "that", " ", "there", " ", "are", " ", "4", " ", 
        "roots", " ", "and", " ", "returns"}], " ", "-", 
       RowBox[{"1", " ", "otherwise"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Min", "[", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"R", "[", 
          RowBox[{"#", ",", "ll1", ",", "ll2", ",", "ll3"}], "]"}], "&"}], "/@",
         "roots"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"heightBound3", "=", "\[IndentingNewLine]", 
  RowBox[{"NMaximize", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MaximizingF1", "[", 
       RowBox[{"l1", ",", "l2", ",", "l3"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"eps", "<=", "l1", "<=", 
        RowBox[{"1", "-", "eps"}]}], "&&", 
       RowBox[{"eps", "<=", "l2", "<=", 
        RowBox[{"1", "-", "eps"}]}], "&&", 
       RowBox[{"eps", "<=", "l3", "<=", 
        RowBox[{"1", "-", "eps"}]}], "&&", 
       RowBox[{
        RowBox[{"l1", "+", "l2", "+", "l3"}], "<=", 
        RowBox[{"1", "-", "eps"}]}]}]}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"l1", ",", "l2", ",", "l3"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{"MaxIterations", "->", "1000"}], ",", "\[IndentingNewLine]", 
    RowBox[{"WorkingPrecision", "->", "50"}], ",", "\[IndentingNewLine]", 
    RowBox[{"AccuracyGoal", "->", "25"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
