Cell[BoxData[
 RowBox[{"D1", "=", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"R", "[", 
      RowBox[{"u", ",", "l1", ",", "l2", ",", "l3"}], "]"}], ",", "u"}], 
    "]"}], "//", "ComplexExpand"}]}]], "Input",
 CellChangeTimes->{{4.000781768722987*^9, 4.000781815899727*^9}, {
  4.000784334663445*^9, 4.0007843352021847`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"56d3fe81-26e1-41ca-a10f-c1646771f60b"],

Cell[BoxData[
 RowBox[{
  FractionBox["l1", 
   RowBox[{"1", "-", "u"}]], "-", 
  FractionBox["l2", 
   RowBox[{"1", "+", "u"}]], "-", 
  FractionBox[
   RowBox[{"5", " ", "l3"}], 
   RowBox[{"3", "+", 
    RowBox[{"5", " ", "u"}]}]], "-", 
  FractionBox["15", 
   RowBox[{"5", "+", 
    RowBox[{"30", " ", "u"}], "+", 
    RowBox[{"29", " ", 
     SuperscriptBox["u", "2"]}]}]], "+", 
  FractionBox[
   RowBox[{"15", " ", "l1"}], 
   RowBox[{"5", "+", 
    RowBox[{"30", " ", "u"}], "+", 
    RowBox[{"29", " ", 
     SuperscriptBox["u", "2"]}]}]], "+", 
  FractionBox[
   RowBox[{"15", " ", "l2"}], 
   RowBox[{"5", "+", 
    RowBox[{"30", " ", "u"}], "+", 
    RowBox[{"29", " ", 
     SuperscriptBox["u", "2"]}]}]], "+", 
  FractionBox[
   RowBox[{"15", " ", "l3"}], 
   RowBox[{"5", "+", 
    RowBox[{"30", " ", "u"}], "+", 
    RowBox[{"29", " ", 
     SuperscriptBox["u", "2"]}]}]], "-", 
  FractionBox[
   RowBox[{"29", " ", "u"}], 
   RowBox[{"5", "+", 
    RowBox[{"30", " ", "u"}], "+", 
    RowBox[{"29", " ", 
     SuperscriptBox["u", "2"]}]}]], "+", 
  FractionBox[
   RowBox[{"29", " ", "l1", " ", "u"}], 
   RowBox[{"5", "+", 
    RowBox[{"30", " ", "u"}], "+", 
    RowBox[{"29", " ", 
     SuperscriptBox["u", "2"]}]}]], "+", 
  FractionBox[
   RowBox[{"29", " ", "l2", " ", "u"}], 
   RowBox[{"5", "+", 
    RowBox[{"30", " ", "u"}], "+", 
    RowBox[{"29", " ", 
     SuperscriptBox["u", "2"]}]}]], "+", 
  FractionBox[
   RowBox[{"29", " ", "l3", " ", "u"}], 
   RowBox[{"5", "+", 
    RowBox[{"30", " ", "u"}], "+", 
    RowBox[{"29", " ", 
     SuperscriptBox["u", "2"]}]}]]}]], "Output",
 CellChangeTimes->{4.00078181645726*^9, 4.000782188470214*^9, 
  4.000782221443571*^9, 4.000786227831949*^9, 4.000812632202662*^9, 
  4.000818631242654*^9, 4.000819632822022*^9},
