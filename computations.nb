  4.00081842313453*^9, 4.0008184249504766`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"ba1e4742-8b1d-4db9-967b-5731960e3eea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A3", "[", "u_", "]"}], ":=", 
  RowBox[{"Log", "[", 
   FractionBox["8", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"5", "u"}], " ", "+", " ", "3"}], "]"}]], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q", "[", 
   RowBox[{"u_", ",", "l1_", ",", "l2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"l1", " ", 
    RowBox[{"A1", "[", "u", "]"}]}], "+", 
   RowBox[{"l2", " ", 
    RowBox[{"A2", "[", "u", "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "l1", "-", "l2"}], ")"}], 
    RowBox[{"A3", "[", "u", "]"}]}]}]}]}], "Input",
 CellChangeTimes->{{4.0007246026700974`*^9, 4.0007246161581993`*^9}, 
   4.000724663086825*^9, {4.0007256216474752`*^9, 4.000725622948365*^9}, {
