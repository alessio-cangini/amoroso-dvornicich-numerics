Cell[CellGroupData[{

Cell["Computing the bound", "Subsection",
 CellChangeTimes->{{4.0007811866472597`*^9, 
  4.0007811886870728`*^9}},ExpressionUUID->"88d22566-98bd-4118-a3e7-\
1a4feceda714"],

Cell[TextData[{
 "Consider the polynomial ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"F", 
    RowBox[{"(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], "=", 
   RowBox[{
    RowBox[{"29", 
     SuperscriptBox["X", "4"]}], "+", 
    RowBox[{"60", 
     SuperscriptBox["X", "3"], "Y"}], "+", 
    RowBox[{"78", 
     SuperscriptBox["X", "2"], 
     SuperscriptBox["Y", "2"]}], "+", 
    RowBox[{"60", 
     SuperscriptBox["XY", "3"]}], "+", 
    RowBox[{"29", 
     SuperscriptBox["Y", "4"]}]}]}]], "InlineCode",ExpressionUUID->
  "42fe0864-59f2-45e9-9ec8-ab1d03f57bc2"],
 " and the associated function ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86142aef-3086-49b0-967e-e77b108dd69f"],
 "."
}], "Text",
 CellChangeTimes->{{4.000781479866886*^9, 4.0007815396882544`*^9}, {
  4.000819439258358*^9, 
  4.000819440171225*^9}},ExpressionUUID->"4616e208-5fa5-4e2d-b5a5-\
0b09b5bbf966"],

