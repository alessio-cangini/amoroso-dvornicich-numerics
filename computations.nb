Cell[TextData[{
 "To numerically compute ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["sup", 
    RowBox[{
     RowBox[{
      SubscriptBox["l", "1"], "\[GreaterEqual]", "0"}], ",", 
     RowBox[{
      SubscriptBox["l", "2"], "\[GreaterEqual]", "0"}], ",", 
     RowBox[{
      RowBox[{
       SubscriptBox["l", "1"], "+", 
       SubscriptBox["l", "2"]}], "\[LessEqual]", "1"}]}]], "min", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Q", "[", 
      RowBox[{
       SubscriptBox["u", "1"], ",", 
       SubscriptBox["l", "1"], ",", 
       SubscriptBox["l", "2"]}], "]"}], ",", 
     RowBox[{"Q", "[", 
      RowBox[{
       SubscriptBox["u", "2"], ",", 
       SubscriptBox["l", "1"], ",", 
       SubscriptBox["l", "2"]}], "]"}]}], "}"}]}]], "InlineCode",
  ExpressionUUID->"cc7ad79c-faa1-40a6-99d7-9d293027328c"],
 ", first define the function ",
 Cell[BoxData[
  RowBox[{"min", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Q", "[", 
      RowBox[{
       SubscriptBox["u", "1"], ",", 
       SubscriptBox["l", "1"], ",", 
       SubscriptBox["l", "2"]}], "]"}], ",", 
     RowBox[{"Q", "[", 
      RowBox[{
       SubscriptBox["u", "2"], ",", 
       SubscriptBox["l", "1"], ",", 
       SubscriptBox["l", "2"]}], "]"}]}], "}"}]}]], "InlineCode",
  ExpressionUUID->"716a8b1d-67f6-49fb-8814-c7d11cf6afc7"],
 ". The parameter ",
 Cell[BoxData[
 "eps"], "InlineCode",ExpressionUUID->
  "c105501a-d929-4093-bfbe-5afc996c352b"],
 " is introduced to avoid convergence issues."
}], "Text",
 CellChangeTimes->{{4.0007769468643837`*^9, 4.0007770586156063`*^9}, {
