   4.000782988336368*^9}, 4.0007862288426332`*^9, 4.000812633154286*^9, 
   4.000818632182415*^9, 4.0008196337295437`*^9, 4.0008606043797617`*^9, 
   4.002273818869734*^9, 4.0022847520138063`*^9, 4.002355229804316*^9, {
   4.002361549788085*^9, 4.0023615676923933`*^9}, 4.002363126242423*^9, 
