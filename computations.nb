ff404a57d969"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"heightBound2", "=", "\[IndentingNewLine]", 
   RowBox[{"NMaximize", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"MaximizingF", "[", 
        RowBox[{"l1", ",", "l2"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"l1", ">=", "eps"}], ",", 
         RowBox[{"l2", ">=", "eps"}], ",", 
         RowBox[{
          RowBox[{"l1", "+", "l2"}], "<=", 
          RowBox[{"1", "-", "eps"}]}]}], "}"}]}], "\[IndentingNewLine]", 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"l1", ",", "l2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"MaxIterations", "->", "1000"}], ",", "\[IndentingNewLine]", 
     RowBox[{"WorkingPrecision", "->", "50"}], ",", "\[IndentingNewLine]", 
     RowBox[{"AccuracyGoal", "->", "25"}]}], "\[IndentingNewLine]", "]"}]}], ";",
   "heightBound2"}]], "Input",
 CellChangeTimes->{
